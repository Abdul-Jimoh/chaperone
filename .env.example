# Copy to .env.local. See docs/SETUP-CREDENTIALS.md for where each value comes from.

APP_URL=http://localhost:3000

DATABASE_URL=
DATABASE_URL_UNPOOLED=

ANTHROPIC_API_KEY=
# Hard cap on total LLM spend for this deployment, in USD.
LLM_BUDGET_USD=1.50

CHANNEL3_API_KEY=

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SHOP_A_MERCHANT_ID=
PAYPAL_SHOP_B_MERCHANT_ID=
PAYPAL_SHOP_C_MERCHANT_ID=
PAYPAL_ROGUE_MERCHANT_ID=
# Each shop's own sandbox REST app. PayPal only lets the payee void a hold, so voids use these.
PAYPAL_SHOP_A_CLIENT_ID=
PAYPAL_SHOP_A_CLIENT_SECRET=
PAYPAL_SHOP_B_CLIENT_ID=
PAYPAL_SHOP_B_CLIENT_SECRET=
PAYPAL_SHOP_C_CLIENT_ID=
PAYPAL_SHOP_C_CLIENT_SECRET=
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# ES256 private JWK (JSON). Mandates are verifiable by anyone holding the public JWKS.
MANDATE_SIGNING_JWK=
# Generate with: openssl rand -base64 32
APPROVAL_LINK_SECRET=
